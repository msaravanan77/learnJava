# Database Configuration
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://admin:${DB_PASSWORD}@postgres:5432/workspace_intelligence

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Qdrant Configuration
QDRANT_URL=http://qdrant:6333

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Use Local Models (optional, set to true to avoid API costs)
USE_LOCAL_LLM=false
LOCAL_MODEL_PATH=/models/codellama-7b

# Embedding Service Configuration
EMBEDDING_MODEL=microsoft/graphcodebert-base
EMBEDDING_DIMENSION=768
DEVICE=cuda  # or 'cpu' if no GPU available
BATCH_SIZE=32

# API Gateway Configuration
JWT_SECRET=your-jwt-secret-key-change-this
API_RATE_LIMIT=1000  # requests per hour per user

# Service Ports (for local development)
API_GATEWAY_PORT=8080
SEARCH_SERVICE_PORT=8001
EMBEDDING_SERVICE_PORT=8002
CONTEXT_ENGINE_PORT=8003
LLM_SERVICE_PORT=8004
INDEXING_SERVICE_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_TELEMETRY=false
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true

# Performance Tuning
MAX_WORKERS=4
TIMEOUT_SECONDS=30
MAX_CONTEXT_TOKENS=4000

# Development
DEBUG=false
HOT_RELOAD=true
